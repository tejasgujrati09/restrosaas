# Copy to .env and fill in real values. Never commit .env.
# Runtime role: non-superuser, subject to RLS. Created by migration 0001.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_dev
# Owner role: runs migrations and seeds test data. Never used by the running API.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_dev
APP_DB_PASSWORD=app
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=dev-only-change-me-not-for-production-0123456789
JWT_ISSUER=restosaas-api
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
APP_DB_ROLE=app
ENVIRONMENT=development
LOG_LEVEL=INFO

# Dev-only: OTPs are printed to the API console instead of sent via WhatsApp/SMS.
OTP_DEV_MODE=true

# Where QR codes and staff invite links point. Product domain is undecided.
PUBLIC_BASE_URL=http://localhost:3000
STAFF_BASE_URL=http://localhost:3001
# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]
# Browser tests only: a fixed OTP. The API refuses to start with this set when ENVIRONMENT=production.
# OTP_DEV_FIXED_CODE=123456

# Voice ordering (phone agent). The API key comes from your environment only; never commit it.
# `voice_tools_base_url` is where the voice platform can reach this API. The number below is the
# one SR number provisioning may use (leave empty to take the first unlinked one); a number that
# is already linked to an agent is never taken. Jobs run on the Celery worker (docker compose
# `worker`, or scripts/dev.sh).
# GUPSHUP_API_KEY=
# GUPSHUP_BASE_URL=
# VOICE_TOOLS_BASE_URL=
# VOICE_SR_NUMBER=
